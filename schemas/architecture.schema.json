{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "system-architect-output",
  "type": "object",
  "required": ["status", "agent", "design_overview", "components", "data_flow", "key_decisions", "risks"],
  "properties": {
    "status": { "type": "string", "enum": ["pending_approval"] },
    "agent": { "type": "string", "enum": ["system-architect"] },
    "design_overview": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "data_flow": { "type": "string" },
    "key_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "traces_to_requirement"],
        "properties": {
          "decision": { "type": "string" },
          "traces_to_requirement": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
